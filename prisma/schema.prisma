generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  NEW
  SHORTLISTED
  APPLIED
  INTERVIEW
  REJECTED
  OFFER
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
}

enum JobSource {
  MANUAL_SEED
  MANUAL
}

enum CompanyTargetStatus {
  TARGET
  WATCH
  EXCLUDED
}

enum CompanyCategory {
  PRODUCT_TECH
  FINTECH_PAYMENTS
  BANKING_TECH
  ENTERPRISE_PLATFORM
  ENGINEERING_SERVICES
  CONSULTING
}

enum VisitorEventType {
  RESUME_VIEWED
  CONTACT_OPENED
  EMAIL_CONTINUE_CLICKED
  RENTORA_OPENED
  EDVORA_OPENED
  LOOM_OPENED
  GITHUB_OPENED
  LINKEDIN_OPENED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  devices      OwnerDevice[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id         String      @id @default(cuid())
  company    String
  title      String
  location   String
  source     JobSource
  status     JobStatus   @default(NEW)
  priority   JobPriority @default(MEDIUM)
  fitScore   Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  companyId  String?
  companyRef Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([companyId])
}

model Company {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  aliases        String[]
  targetStatus   CompanyTargetStatus @default(TARGET)
  categories     CompanyCategory[]
  careerUrl      String?
  knownLocations String[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  jobs           Job[]

  @@index([name])
  @@index([targetStatus])
}

model PageVisit {
  id          String   @id @default(cuid())
  path        String
  visitedAt   DateTime @default(now())
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  country     String?
  region      String?
  city        String?
  userAgent   String?
  viewportWidth  Int?
  viewportHeight Int?
  browserLanguage String?
  browserTimezone String?
  visitorKey  String
  sessionKey  String

  @@index([visitedAt])
  @@index([visitedAt, id])
  @@index([path])
  @@index([visitorKey])
  @@index([sessionKey])
}

model VisitorEvent {
  id         String           @id @default(cuid())
  visitorKey String
  sessionKey String
  type       VisitorEventType
  path       String
  occurredAt DateTime         @default(now())

  @@index([occurredAt])
  @@index([sessionKey, occurredAt])
  @@index([visitorKey, occurredAt])
}

model OwnerDevice {
  id           String   @id @default(cuid())
  visitorKey   String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  userAgent    String?
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  logins       OwnerLogin[]

  @@index([userId])
}

model OwnerLogin {
  id         String      @id @default(cuid())
  deviceId   String
  device     OwnerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  occurredAt DateTime    @default(now())

  @@index([deviceId, occurredAt])
}

// Contact details are self-reported, never treated as verified identity.
model VoiceEnquiry {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  reason         String
  message        String
  consentVersion String
  audioConsent   Boolean @default(false)
  audioState     String @default("NONE")
  audioKey       String?
  audioMime      String?
  audioBytes     Int @default(0)
  audioParts     VoiceRecordingPart[]
  costTrackingVersion Int?
  voiceModel     String?
  usageEvents    VoiceUsage[]
  accessHash     String   @unique
  callerHash     String
  state          String   @default("SAVED")
  followUp       String   @default("NEW")
  callId         String?  @unique
  transcript     String   @default("")
  summary        String?
  summaryKind    String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([callerHash, createdAt])
  @@index([email, createdAt])
  @@index([state, startedAt])
}

model VoiceUsage {
  id          String @id @default(cuid())
  enquiryId   String
  enquiry     VoiceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  eventKey    String
  kind        String
  model       String
  usage       Json
  lineItems   Json
  costUsd     Decimal? @db.Decimal(18, 9)
  issue       String?
  rateVersion String
  createdAt   DateTime @default(now())

  @@unique([enquiryId, eventKey])
  @@index([enquiryId, createdAt])
}

model VoiceRecordingPart {
  id        String @id @default(cuid())
  enquiryId String
  enquiry   VoiceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  index     Int
  key       String @unique
  digest    String
  bytes     Int
  mime      String
  createdAt DateTime @default(now())

  @@unique([enquiryId, index])
}
