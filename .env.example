DATABASE_URL="postgresql://careeros:careeros_dev@localhost:5436/careeros?schema=public"
# Enable only when the proxy overwrites all x-geo-* headers.
TRUST_ANALYTICS_PROXY="false"
ANALYTICS_RETENTION_MONTHS="6"

# AI voice enquiry (server-only; never use NEXT_PUBLIC_ for the API key)
APP_ORIGIN="https://suchay.dev"
OPENAI_API_KEY=""
VOICE_ENABLED="false"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
OPENAI_SUMMARY_MODEL="gpt-5.4-mini"
VOICE_MAX_SECONDS="180"
VOICE_DAILY_CALL_LIMIT="20"
# Enable only if your reverse proxy overwrites X-Real-IP with the client address.
TRUST_VOICE_PROXY="false"

# Private conversation recordings, server-only; object prefix projects/suchay.dev/conversations/
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_REGION="sgp1"
DO_SPACES_BUCKET=""
DO_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
